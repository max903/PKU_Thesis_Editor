{
  "$schema": "./sections.schema.json",
  "id": "pku-graduate-thesis-sections",
  "version": "2014.05",
  "sections": [
    {
      "id": "cover",
      "type": "cover",
      "name": "封面",
      "name_en": "Cover",
      "required": true,
      "order": 1,
      "inTableOfContents": false,
      "pageNumbering": false,
      "fields": [
        { "id": "title", "name": "论文题目", "required": true, "maxLength": 20 },
        { "id": "author", "name": "姓名", "required": true },
        { "id": "studentId", "name": "学号", "required": true },
        { "id": "department", "name": "院系", "required": true },
        { "id": "major", "name": "专业", "required": true },
        { "id": "direction", "name": "研究方向", "required": true },
        { "id": "supervisor", "name": "导师", "required": true },
        { "id": "supervisorTitle", "name": "导师职称", "required": true },
        { "id": "completionDate", "name": "完成日期", "required": true }
      ]
    },
    {
      "id": "copyright",
      "type": "copyright",
      "name": "版权声明",
      "name_en": "Copyright Declaration",
      "required": true,
      "order": 2,
      "inTableOfContents": false,
      "pageNumbering": false,
      "fixedContent": true
    },
    {
      "id": "abstract_cn",
      "type": "abstract_cn",
      "name": "摘要",
      "name_en": "Abstract (Chinese)",
      "required": true,
      "order": 3,
      "inTableOfContents": false,
      "pageNumbering": "roman",
      "constraints": {
        "minLength": { "master": 600, "doctor": 800 },
        "maxLength": { "master": 600, "doctor": 1000 },
        "noImages": true,
        "noTables": true
      },
      "fields": [
        { "id": "content", "name": "摘要内容", "required": true },
        { "id": "keywords", "name": "关键词", "required": true, "minCount": 3, "maxCount": 5 },
        { "id": "funding", "name": "基金资助", "required": false }
      ]
    },
    {
      "id": "abstract_en",
      "type": "abstract_en",
      "name": "ABSTRACT",
      "name_en": "Abstract (English)",
      "required": true,
      "order": 4,
      "inTableOfContents": false,
      "pageNumbering": "roman",
      "fields": [
        { "id": "title", "name": "English Title", "required": true },
        { "id": "author", "name": "Author Name", "required": true },
        { "id": "major", "name": "Major", "required": true },
        { "id": "supervisor", "name": "Supervisor", "required": true },
        { "id": "content", "name": "Abstract Content", "required": true },
        { "id": "keywords", "name": "KEY WORDS", "required": true, "minCount": 3, "maxCount": 5 }
      ]
    },
    {
      "id": "toc",
      "type": "toc",
      "name": "目录",
      "name_en": "Table of Contents",
      "required": true,
      "order": 5,
      "inTableOfContents": false,
      "pageNumbering": "roman",
      "autoGenerated": true,
      "maxDepth": 3
    },
    {
      "id": "symbols",
      "type": "symbols",
      "name": "主要符号对照表",
      "name_en": "List of Symbols",
      "required": false,
      "order": 6,
      "inTableOfContents": true,
      "pageNumbering": "roman"
    },
    {
      "id": "chapter_intro",
      "type": "chapter",
      "name": "引言",
      "name_en": "Introduction",
      "required": true,
      "order": 7,
      "inTableOfContents": true,
      "pageNumbering": "arabic",
      "chapterNumber": 1,
      "alternativeNames": ["绪论", "序言", "导论"]
    },
    {
      "id": "chapters",
      "type": "chapter_group",
      "name": "正文章节",
      "name_en": "Main Chapters",
      "required": true,
      "order": 8,
      "inTableOfContents": true,
      "pageNumbering": "arabic",
      "minCount": 1,
      "maxCount": null
    },
    {
      "id": "chapter_conclusion",
      "type": "chapter",
      "name": "结论与展望",
      "name_en": "Conclusion and Future Work",
      "required": true,
      "order": 9,
      "inTableOfContents": true,
      "pageNumbering": "arabic"
    },
    {
      "id": "references",
      "type": "references",
      "name": "参考文献",
      "name_en": "References",
      "required": true,
      "order": 10,
      "inTableOfContents": true,
      "pageNumbering": "arabic"
    },
    {
      "id": "appendices",
      "type": "appendix_group",
      "name": "附录",
      "name_en": "Appendices",
      "required": false,
      "order": 11,
      "inTableOfContents": true,
      "pageNumbering": "arabic",
      "numbering": "A, B, C..."
    },
    {
      "id": "acknowledgements",
      "type": "acknowledgements",
      "name": "致谢",
      "name_en": "Acknowledgements",
      "required": true,
      "order": 12,
      "inTableOfContents": true,
      "pageNumbering": "arabic",
      "constraints": {
        "maxLength": 1000
      }
    },
    {
      "id": "declaration",
      "type": "declaration",
      "name": "学位论文原创性声明和授权使用说明",
      "name_en": "Originality Declaration",
      "required": true,
      "order": 13,
      "inTableOfContents": true,
      "pageNumbering": "arabic",
      "fixedContent": true
    }
  ]
}
